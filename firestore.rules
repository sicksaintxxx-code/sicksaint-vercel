rules_version = '2';

// SICKSAINT Production Firestore Security Rules
// Public editorial reads and all data operations are served through
// the server-side Laravel REST API using a trusted Google Service Account credential.
// The Next.js browser client has no direct Firestore read or write call sites.
// To prevent unauthorized direct client access or data leakage,
// all direct browser SDK client reads and writes are denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
